# Repository conventions (CIS §4). Generated and local-only files never enter version control.

# Local configuration and secrets (.env.example is the committed template)
.env

# Runtime data (SQLite, created only when persistence is enabled)
data/

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend dependencies and build output
node_modules/
dist/
test-results/
playwright-report/

# OS and editor files
.DS_Store
Thumbs.db
