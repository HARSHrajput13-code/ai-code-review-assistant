# Every configuration key with its default (CIS §16.2). Copy to .env to override; .env is git-ignored.
# V1 needs no secrets. backend/config.py is the only reader of these values (CIS §16.1).

APP_ENV=development
APP_HOST=127.0.0.1
APP_ALLOW_NON_LOOPBACK=false
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

MAX_SOURCE_BYTES=12000
MAX_SOURCE_LINES=500

REVIEW_TIMEOUT_SECONDS=300
REVIEW_MAX_CONCURRENT=1
REVIEW_MAX_QUEUED=2
REVIEW_RESULT_TTL_SECONDS=900
REVIEW_MAX_RETAINED=50

STATIC_TOOL_TIMEOUT_SECONDS=30
STATIC_PYLINT_ENABLED=true
STATIC_BANDIT_ENABLED=true
IMPROVEMENT_ENABLED=true

AI_PROVIDER=ollama
AI_PROMPT_VERSION=v1
AI_OUTPUT_RETRY_COUNT=1
AI_ALLOW_REMOTE_ENDPOINT=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL is required for AI_PROVIDER=ollama. No model is selected yet: the value comes from
# the M2 model-selection record (CIS §20.9, §20.10), and OLLAMA_MODEL_DIGEST is set at the M2 freeze.
# OLLAMA_MODEL=
# OLLAMA_MODEL_DIGEST=
OLLAMA_TEMPERATURE=0.0
OLLAMA_SEED=42
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=8192
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=10m

PERSISTENCE_ENABLED=false
SQLITE_PATH=./data/reviews.sqlite3
